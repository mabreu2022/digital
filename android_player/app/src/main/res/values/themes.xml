<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DigitalSignagePlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.DigitalSignagePlayer.Fullscreen" parent="Theme.DigitalSignagePlayer">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">shortEdges</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
